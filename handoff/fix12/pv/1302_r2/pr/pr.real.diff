--- /Users/davida.ventimiglia/.claude/jobs/8d94cdfa/tmp/fix12/pv/1302_r2/pr/base/tests/timescale/db/69_from_hypertable_mixed_step_and_unit_remedy_test.sql	1969-12-31 16:00:00
